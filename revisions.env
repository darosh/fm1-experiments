# Pinned upstream revisions. Sourced by scripts/*.sh; keep it plain KEY=value.
# Update a pin only together with the patches that sit on top of it (see README).

# charlesvestal/fm1-loom -- LOOM-8 (the firmware we build)
# v0.11: b/w is the default theme (a picked theme is kept with a flag), per-sound hit settings on kit
# steps (LANE_HIT0), solo on Mix, "on note" REC. Its base submodule names fm1-base main d8ff8f4.
FM1_LOOM_URL="https://github.com/charlesvestal/fm1-loom.git"
FM1_LOOM_COMMIT="c19e076d29af23d0f4aeb9578faf33ce78df287f"      # v0.11

# charlesvestal/fm1-amb -- AMB-1, the second firmware on fm1-base
FM1_AMB_URL="https://github.com/charlesvestal/fm1-amb.git"
FM1_AMB_COMMIT="188b0a42f20a547864e732ae5ea1339d0fbcf395"       # v1.3

# styvesgoupil/frasil -- FRASIL, ambient drones on fm1-base (base/, a submodule of the author's own fork).
# Pinned to main, 2.0.1. Its base/ names styvesgoupil/fm1-base's frasil branch (5da1f3d), an old fm1-base
# plus two backup commits; patches/fm1-base/10-backup-restore brings those onto our pin, so the clone links
# our fm1-base like fm1-loom and fm1-amb do.
FRASIL_URL="https://github.com/styvesgoupil/frasil.git"
FRASIL_COMMIT="422cac668d2753cda4e76e07d5a1f26bf4b1007e"        # v2.0.1

# charlesvestal/fm1-base -- the platform layer (the firmware's base/ submodule)
# Pinned to main d8ff8f4, which merged own-bt (the own Bluetooth stack, bt/) and adds .rfm1 builds
# (tools/build.py --rfm1). LOOM-8 v0.11 names it; AMB-1 v1.3 names an older main, an ancestor.
FM1_BASE_URL="https://github.com/charlesvestal/fm1-base.git"
FM1_BASE_COMMIT="d8ff8f41aa511e03d70a7c565c9fa0f1dd18ae2f"

# hugelton/felucca-bsp -- the chip layer (fm1-base's bsp/ submodule)
# 305c372 is own-bt's tip, which fm1-base main d8ff8f4 names: main (#10 FELUCCA_UAC_AS_FIRST, #11
# FM1_CRASH_CTX_N) merged into the BLE radio drivers (ble_rf_tables_v15.h, fm1_ble.h, fm1_bredr.h,
# fm1_rf_cal.h) that fm1-base's own BT stack needs. It is 6 commits ahead of main's 5942e68.
FELUCCA_BSP_URL="https://github.com/hugelton/felucca-bsp.git"
FELUCCA_BSP_COMMIT="305c372c3ec18f3917744e608998a0d7fd700135"

# hugelton/Felucca -- the standalone firmware (its own platform under firmware/, not fm1-base).
# Pinned to main, which is 5 commits past v1.6.1 (the BPM 0 fix in fx.c, #282).
FELUCCA_URL="https://github.com/hugelton/Felucca.git"
FELUCCA_COMMIT="63f88ec18b71c6ed4371d03d6f04dd93f4193ad3"

# hugelton/Felucca-Engines -- Felucca's firmware/engines submodule (MIT), shared as a symlinked clone.
# Pinned to the commit Felucca's own tree names, not to engines main (which adds PHASE and the FS-rate
# refactor; Felucca has its own firmware/src/eng_phase.c and its goldens pair with this one).
FELUCCA_ENGINES_URL="https://github.com/hugelton/Felucca-Engines.git"
FELUCCA_ENGINES_COMMIT="c46e0086f69bdc26df1cd144dca9e683cc4531dd"

# nzimas/tonitor -- TONITOR, standalone firmware on a vendored Felucca/SLOOP platform (no submodules;
# its firmware/ is its own, from Felucca and SLOOP). Pinned to main, 0.56.
TONITOR_URL="https://github.com/nzimas/tonitor.git"
TONITOR_COMMIT="f51bd68313f09a113b69ed0740a7866d912de8ba"

# isod89/sloop-fm1 -- SLOOP, standalone firmware on its own Felucca/SLOOP platform (no submodules;
# its firmware/ comes from Felucca and SLOOP). Pinned to main, 2.8.1.
SLOOP_URL="https://github.com/isod89/sloop-fm1.git"
SLOOP_COMMIT="d89364253b79a5c6002c0d90c5f16b3c3c16ea9d"

# zvenson/dinghy -- Dinghy, the small "build your own" firmware on the Felucca/SLOOP platform (vendored:
# no submodules; firmware/src/usb.c is an older SLOOP copy, interface order AC, MIDI, AS). Pinned to main, 0.4.
DINGHY_URL="https://github.com/zvenson/dinghy.git"
DINGHY_COMMIT="22acb9165ebc8baa712af3aff8c507e230c1e028"

# twochannels/CS-1 -- CS-1, a CS-80-style synthesizer on the Dinghy platform (vendored: no submodules;
# its firmware/src/usb.c is Dinghy's, same older layout). Pinned to main, 0.3.4.
CS1_URL="https://github.com/twochannels/CS-1.git"
CS1_COMMIT="5dce8fadd3aa86cf47a3290289ee1c10b7c102e4"

# keremimo/melodee -- Melodee, a standalone GPL-3.0 fork of Felucca with its own USB stack (vendored:
# no submodules; firmware/src/usb.c, usb_audio.c, usb_audio_stream.c, usb_audio_desc.h). Its USB
# layout needs no patch here; README section 7 has the difference from bsp/base. Pinned to main, v1.4.5.
MELODEE_URL="https://github.com/keremimo/melodee.git"
MELODEE_COMMIT="398ada1e09d864c12f3b778a43e45c7c2a8031b8"

# kidbee85-beep/mutable-dreams -- Mutable Dreams 1.1, standalone on a vendored fm1-base snapshot: its
# base/ is fm1-base bbfd461 with the app's own delta (plat.h's bench hooks, device/sysex_dispatch.h,
# the backup tooling, gen_font.py's "dreams" set) and base/bsp/ is felucca-bsp 33cac69. The repository
# carries no source tree, only release archives: setup.sh extracts SOURCE into clones/mutable-dreams/src.
# Pinned to the v1.1 commit and the archive's SHA-256 (both the repo's copy and the raw download match).
MUTABLE_DREAMS_URL="https://github.com/kidbee85-beep/mutable-dreams.git"
MUTABLE_DREAMS_COMMIT="04cf468420f4325f6bdbbecfd59695b06c481a8a"  # v1.1
MUTABLE_DREAMS_SOURCE="Mutable-Dreams-1.1-Source.zip"
MUTABLE_DREAMS_SOURCE_SHA256="90fef68214bd1ff6674db2c80852cc2291b31321e9c26cb20cf59d45ee04af40"
MUTABLE_DREAMS_SOURCE_DIR="mutable-dreams-1.1"

# aceyprime/zen-1 -- ZEN-1, standalone firmware on the Felucca platform via FoMni (vendored: no
# submodules; the platform under firmware/ is FoMni's at docs/upstream.md).
ZEN1_URL="https://github.com/aceyprime/zen-1.git"
ZEN1_COMMIT="ec9295233ea64ddac224b58b4d07216706c1b8ee"         # v1.2

# charlesvestal/fm1-fomni -- the commit ZEN-1's platform byte-for-byte guard compares against
# (docs/upstream.md), and the later one its installers come from. Fetched into clones/zen-1, not cloned.
ZEN1_PLATFORM_URL="https://github.com/charlesvestal/fm1-fomni.git"
ZEN1_PLATFORM_UPSTREAM="b81eb6b661c35948ec2d1059664d4e5790999305"
ZEN1_INSTALL_UPSTREAM="6c326230af03c66a77ba68e1af72cf3341e34208"

# JieLi AC79 SDK (external, ~1.4 GB: not cloned into this repo)
AC79_SDK_URL="https://gitee.com/Jieli-Tech/fw-AC79_AIoT_SDK.git"
AC79_SDK_TAG="AC79NN_SDK_V1.2.14_2026-10-13"

# JieLi toolchain: Linux x86-64 clang, run in a container on macOS.
# The URL serves the newest package server build; VERSION is the tarball name it currently
# resolves to, reported (not enforced) by setup.sh.
JIELI_TOOLCHAIN_URL="https://pkgman.jieliapp.com/s/linux-toolchain"
JIELI_TOOLCHAIN_VERSION="jieli-linux-toolchains-20260730.1"
JIELI_DOCKER_IMAGE="debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8"

# Python packages setup.sh installs into .venv (mido + python-rtmidi for the USB-MIDI tools,
# fontTools for Felucca's UI font/icons generator, numpy + scipy for ZEN-1's reference analysis
# selftest; Pillow comes from Homebrew's python3.15)
PY_MIDO_VERSION="1.3.3"
PY_RTMIDI_VERSION="1.5.8"
PY_FONTTOOLS_VERSION="4.66.1"
PY_NUMPY_VERSION="2.5.4"
PY_SCIPY_VERSION="1.18.1"
PY_FREETYPE_VERSION="2.5.1"

# DejaVu Sans for LOOM-8's mixed font set (patches/fm1-loom/03-mixed-fonts): the release tarball,
# fetched by scripts/setup.sh into assets/fonts/ and pinned by SHA-256
DEJAVU_URL="https://github.com/dejavu-fonts/dejavu-fonts/releases/download/version_2_37/dejavu-fonts-ttf-2.37.tar.bz2"
DEJAVU_ARCHIVE="dejavu-fonts-ttf-2.37.tar.bz2"
DEJAVU_SHA256="fa9ca4d13871dd122f61258a80d01751d603b4d3ee14095d65453b4e846e17d7"
DEJAVU_DIR="dejavu-fonts-ttf-2.37"
