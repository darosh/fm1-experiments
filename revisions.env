# Pinned upstream revisions. Sourced by scripts/*.sh; keep it plain KEY=value.
# Update a pin only together with the patches that sit on top of it (see README).

# charlesvestal/fm1-loom -- LOOM-8 (the firmware we build)
FM1_LOOM_URL="https://github.com/charlesvestal/fm1-loom.git"
FM1_LOOM_COMMIT="75e8607ca9115bda1a87457d5bc819f78e90416c"      # v0.7

# charlesvestal/fm1-amb -- AMB-1, the second firmware on fm1-base
FM1_AMB_URL="https://github.com/charlesvestal/fm1-amb.git"
FM1_AMB_COMMIT="188b0a42f20a547864e732ae5ea1339d0fbcf395"       # v1.3

# charlesvestal/fm1-base -- the platform layer (the firmware's base/ submodule)
# Pinned to main, which is ahead of the commit the firmwares' own submodule pointers name.
FM1_BASE_URL="https://github.com/charlesvestal/fm1-base.git"
FM1_BASE_COMMIT="0944289db886fa212ebd82d853b8aa474bfb0677"

# hugelton/felucca-bsp -- the chip layer (fm1-base's bsp/ submodule)
FELUCCA_BSP_URL="https://github.com/hugelton/felucca-bsp.git"
FELUCCA_BSP_COMMIT="b413cd888424249d417d5549b594e8492d399d3e"

# JieLi AC79 SDK (external, ~1.4 GB: not cloned into this repo)
AC79_SDK_URL="https://gitee.com/Jieli-Tech/fw-AC79_AIoT_SDK.git"
AC79_SDK_TAG="AC79NN_SDK_V1.2.14_2026-10-13"

# JieLi toolchain: Linux x86-64 clang, run in a container on macOS.
# The URL serves the newest package server build; VERSION is the tarball name it currently
# resolves to, reported (not enforced) by setup.sh.
JIELI_TOOLCHAIN_URL="https://pkgman.jieliapp.com/s/linux-toolchain"
JIELI_TOOLCHAIN_VERSION="jieli-linux-toolchains-20260730.1"
JIELI_DOCKER_IMAGE="debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8"

# Python packages setup.sh installs into .venv (mido + python-rtmidi for the USB-MIDI tools)
PY_MIDO_VERSION="1.3.3"
PY_RTMIDI_VERSION="1.5.8"
