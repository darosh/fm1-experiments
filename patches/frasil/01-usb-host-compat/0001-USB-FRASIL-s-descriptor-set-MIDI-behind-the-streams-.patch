From 2b7f3bc27f0a334c8beb9ca93b9cb88cdb649841 Mon Sep 17 00:00:00 2001
From: Jan Forst <ensonador@gmail.com>
Date: Tue, 27 Oct 2026 07:39:08 +0100
Subject: [PATCH] USB: FRASIL's descriptor set (MIDI behind the streams, an
 audio IAD, the names)

usb_midi_last puts the MIDI function behind the streaming interfaces (macOS 13-15 audio input,
hugelton/Felucca#67, kmplngj/Felucca#532). usb_iad groups AC + AS behind one IAD: descriptor
hygiene, not a host fix, and it needs usb_midi_last so those interfaces stay contiguous.
usb_audio_first lists the streaming interface first inside the AC collection, as LOOM-8 does.

The USB names follow LOOM-8's convention: the platform as the Manufacturer and the platform plus
the firmware as the product. The serial number string keeps its default (the package identity,
FM-1_4700 for a dev build), so a host tells this firmware from the others sharing VID/PID
1209:0001.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 app/fm1.toml | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/app/fm1.toml b/app/fm1.toml
index 240f55f..b6280d7 100644
--- a/app/fm1.toml
+++ b/app/fm1.toml
@@ -1,9 +1,14 @@
 # FRASIL's build settings (fm1-base's tools/build.py: ./build.sh)
 name = "FRASIL"                # the build's files: frasil.fwsc, frasil-X.Y.fwsc
 id_prefix = "FM-1_47"          # package identity: dev FM-1_4700, releases FM-1_47XXYYZZ
-usb_manufacturer = "FRASIL"
-usb_product = "FRASIL FM-1"
+usb_manufacturer = "FM-1"      # Manufacturer in Audio MIDI Setup
+usb_product = "FM-1 FRASIL"    # Model, and the CoreAudio / CoreMIDI device name
 ble = false                    # no Bluetooth: its RAM and pool go to the sound
+usb_audio_first = true         # the audio streaming interface listed first (macOS shows the audio device: felucca-bsp #10)
+usb_midi_last = true           # MIDI after the streaming interfaces (macOS audio, Felucca#67): bisected,
+                               # this is the one that matters; it also keeps MIDI out of the AC collection
+usb_iad = true                 # the audio function's IAD (FELUCCA_UAC_IAD): descriptor hygiene,
+                               # not a host fix; wants usb_midi_last so AC + AS stay contiguous
 backup = true                  # the scenes and the settings backed up and restored over USB (device/backup.c)
 backup_ext = "frasil"          # the backup files: scenes.frasil
 backup_holds = "the 16 scenes and the settings"
