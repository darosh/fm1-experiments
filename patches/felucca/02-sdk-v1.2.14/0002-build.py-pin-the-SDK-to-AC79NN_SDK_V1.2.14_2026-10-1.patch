From 27bbb76d936be0ba4d91bcf04c18bc7e502e4c90 Mon Sep 17 00:00:00 2001
From: Jan Forst <ensonador@gmail.com>
Date: Sat, 24 Oct 2026 13:45:47 +0200
Subject: [PATCH 2/3] build.py: pin the SDK to AC79NN_SDK_V1.2.14_2026-10-13

SDK_SHA256 named the V1.2.1 files while the installed SDK is V1.2.14, so every build warned.
cfg_tool.bin is unchanged between the two; uboot.boot and cfg/eq_cfg_hw.bin differ.

uboot.boot sits in the flash head below 0x4000, which the update loader never writes: a firmware
installed over USB-MIDI keeps the SPL already on the device. So the pin documents what is installed
rather than changing what the device runs. (The same patch as fm1-base's.)

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 tools/build.py | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/tools/build.py b/tools/build.py
index ecb5d95..ada2ff3 100755
--- a/tools/build.py
+++ b/tools/build.py
@@ -42,11 +42,15 @@ DOCKER_IMAGE = os.environ.get("JIELI_DOCKER_IMAGE", "debian:bookworm-slim")
 CFLAGS = ["-Os", "-ffunction-sections", "-fno-builtin", "-Wall", "-Wno-unused-function"]
 LINE = re.compile(r"^\s*([0-9a-f]+):\s+((?:[0-9a-f]{2} )+)\s*\t(.*)$")
 
-# SDK files of AC79NN_SDK_V1.2.1_2023-12-13 (the tested version)
+# SDK files of AC79NN_SDK_V1.2.14_2026-10-13 (the installed version; the same as fm1-base's pin).
+# cfg_tool.bin is unchanged from V1.2.1; uboot.boot and cfg/eq_cfg_hw.bin differ. uboot.boot sits in
+# the flash head below 0x4000, which the update loader never writes: a firmware installed over
+# USB-MIDI keeps the SPL already on the device, so this documents what is installed rather than
+# changing what the device runs.
 SDK_SHA256 = {
-    "uboot.boot": "4e3b4c220dc96641cb5a723f41e68ce41d5261ae9434bb33fbd7f2c59976ded4",
+    "uboot.boot": "64ccc63e4df3238046fadb200f1b134311d8fe6ec6e3ccb8c8b81379231b867e",
     "cfg_tool.bin": "276579954f076886a6a7694f65dc71c034a63a2c204b76749065c0ac7b010d1b",
-    "cfg/eq_cfg_hw.bin": "41167491bffed4651750719c973d2758adeb9021a5670d02d6a53c85ed80ea7d",
+    "cfg/eq_cfg_hw.bin": "179ac9f4501d2cf8c3bdbc06fcda1e46228b7ace7e339342c767bb6568de57d8",
 }
 
 PRODUCT = "FM-1_900"                # package identity; release builds are FM-1_9XY
@@ -392,7 +396,7 @@ def main():
     fm1pkg_make.SDK = a.sdk
     for rel, sha in SDK_SHA256.items():          # fail early without the SDK
         if hashlib.sha256(fm1pkg_make.sdk_file(rel)).hexdigest() != sha:
-            print(f"warning: SDK {rel} differs from AC79NN_SDK_V1.2.1; the package will not match the reference")
+            print(f"warning: SDK {rel} differs from AC79NN_SDK_V1.2.14; the package will not match the reference")
     OUT.mkdir(parents=True, exist_ok=True)
     with ThreadPoolExecutor(2) as ex:
         gen, ldr = ex.submit(generate), ex.submit(build_loader)
-- 
