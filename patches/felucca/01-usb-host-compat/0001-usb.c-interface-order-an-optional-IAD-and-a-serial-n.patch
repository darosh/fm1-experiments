@@ -283,8 +351,18 @@ static void midi_out_event(uint32_t pkt)            /* from the audio ISR */
     9, 5, 0x81, 2, 64, 0, 0, 0, 0,                                                                   \
     5, 0x25, 1, 1, 3,
 #define D_AUDIO(a) D_AC(a) D_MIDI((a) + 1) D_AS((a) + 2)   /* audio + MIDI from interface a */
+/* the plain build's audio function: with MIDI_LAST the streams come first and MIDI after them, so the
