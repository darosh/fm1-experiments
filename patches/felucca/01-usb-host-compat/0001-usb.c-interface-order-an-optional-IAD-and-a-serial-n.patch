 static const uint8_t STR0[4] = {4, 3, 0x09, 0x04};
 static const uint8_t STR1[] = {42, 3, 'H', 0, 0xFC, 0, 'g', 0, 'e', 0, 'l', 0, 't', 0, 'o', 0, 'n', 0, ' ', 0, 'I', 0,
                                'n', 0, 's', 0, 't', 0, 'r', 0, 'u', 0, 'm', 0, 'e', 0, 'n', 0, 't', 0, 's', 0};
@@ -356,6 +450,26 @@ static const uint8_t STR2[] = {30, 3, 'F', 0, 'e', 0, 'l', 0, 'u', 0, 'c', 0, 'c
 #else
 static const uint8_t STR2[] = {16, 3, 'F', 0, 'e', 0, 'l', 0, 'u', 0, 'c', 0, 'c', 0, 'a', 0};
 #endif
+#if FELUCCA_USB_SNUM
+/* A string descriptor built from a plain ASCII string (FELUCCA_USB_SERIAL, e.g. "FM-1_900"), at most 31
+ * characters. EP0 sends one descriptor at a time, so one buffer serves it. */
+static uint8_t usb_str_buf[2 + 2 * 31];
+
+static int usb_str_desc(const char *s, const uint8_t **d, uint16_t *l)
+{
+    uint32_t n = 0;
+    while (s[n] && n < 31u) {
+        usb_str_buf[2 + 2 * n] = (uint8_t)s[n];
+        usb_str_buf[3 + 2 * n] = 0;
+        n++;
+    }
+    usb_str_buf[0] = (uint8_t)(2 + 2 * n);
+    usb_str_buf[1] = 3;
+    *d = usb_str_buf;
+    *l = (uint16_t)(2 + 2 * n);
+    return 1;
+}
+#endif
 
 static int get_desc(uint32_t wvalue, const uint8_t **d, uint16_t *l)
 {
@@ -382,6 +496,12 @@ static int get_desc(uint32_t wvalue, const uint8_t **d, uint16_t *l)
