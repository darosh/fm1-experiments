index 0000000..1f6ea25
--- /dev/null
+++ b/tests/usb_compat_test.c
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Copyright (C) 2026 Jan Forst */
+/* Host-side test of the fm-1-experiments USB descriptors (FELUCCA_UAC_MIDI_LAST, FELUCCA_UAC_AC_COLLECT,
+ * FELUCCA_UAC_IAD, FELUCCA_USB_SERIAL), the set scripts/build-felucca.sh ships: a plain build
+ * (FELUCCA_CDC=0, FELUCCA_UAC=1) with the MIDI function behind the streaming interfaces, and optionally
+ * the audio function's IAD. One build per variant:
+ *   -DT_ML=0/1 (FELUCCA_UAC_MIDI_LAST)  -DT_IAD=0/1 (FELUCCA_UAC_IAD)
+ * The device and configuration descriptors come from get_desc(), as GET_DESCRIPTOR sends them: order
+ * AC, AS, MIDI (with MIDI_LAST) or AC, MIDI, AS (stock), the AC collection, the IAD (AC + AS, never
+ * MIDI), the device class, UAC_AS_IF, bcdDevice's flag bits and string descriptor 3 (the serial).
+ * The stock descriptors themselves stay covered by tests/usb_desc_test.c. */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#define RING_PUBLISH() __asm__ volatile("" ::: "memory")
+#define HALF_FRAMES 128
+#define FELUCCA_OTA 1
+#define FELUCCA_CDC 0
+#define FELUCCA_UAC 1
+#ifndef T_ML
+#define T_ML 1
+#endif
+#ifndef T_IAD
+#define T_IAD 1
+#endif
+#define FELUCCA_UAC_MIDI_LAST T_ML
+#define FELUCCA_UAC_IAD T_IAD
+#define FELUCCA_ID "FM-1_900"
+static void fm1_delay_ms(uint32_t ms) { (void)ms; }
+#pragma GCC diagnostic ignored "-Wint-to-pointer-cast"   /* SIE register macros (never touched here) */
+#include "../firmware/src/usb.c"
+static uint32_t ota_now_ms(void) { return 0; }
+static void ota_idle(void) {}
+
+static int fails;
+static void check(const char *what, int ok)
+{
+    printf("%-72s %s\n", what, ok ? "ok" : "FAIL");
+    if (!ok)
+        fails++;
+}
+
+static uint32_t le16(const uint8_t *p) { return p[0] | (uint32_t)p[1] << 8; }
+
+int main(void)
+{
+    const uint8_t *dev, *c, *sd;
+    uint16_t dev_len, n, sd_len;
+    uint32_t off, i, ac = 99, as = 99, midi = 99, nif = 0, niad = 0;
+    uint32_t ac_class = 0, as_class = 0, midi_class = 0, coll_n = 0, coll[4] = {0};
+    uint32_t iad_first = 0, iad_n = 0, iad_cls = 0, iad_sub = 0, iad_proto = 0;
+    uint32_t midi_out = 0, midi_in = 0, audio_in = 0;
+    int ac_hdr = 0;
+
+    printf("-- USB host-compat descriptors: MIDI_LAST %d, IAD %d\n", T_ML, T_IAD);
+    check("GET_DESCRIPTOR device", get_desc(0x0100, &dev, &dev_len) && dev_len == 18 && dev[0] == 18);
+    check("GET_DESCRIPTOR configuration", get_desc(0x0200, &c, &n) && c[1] == 2 && le16(c + 2) == n);
+    check("GET_DESCRIPTOR string 3 (the serial)", get_desc(0x0303, &sd, &sd_len) && sd_len == 2 + 2 * 8);
+
+    /* ---- the device ---- */
+    if (T_IAD)
+        check("misc / IAD: bcdUSB 2.00, class EF 02 01",
+              le16(dev + 2) == 0x0200 && dev[4] == 0xEF && dev[5] == 2 && dev[6] == 1);
+    else
+        check("no IAD: bcdUSB 1.10, class 00 00 00",
+              le16(dev + 2) == 0x0110 && !dev[4] && !dev[5] && !dev[6]);
+    check("iSerialNumber 3", dev[16] == 3);
+    {
+        /* 3.xx: +0x10 the audio input, +0x20 the 48 kHz rate, +0x08 AS_FIRST, +0x04 MIDI_LAST, +0x40 IAD */
+        uint32_t bcd = 0x0300u + 0x10u * (FELUCCA_UAC + FELUCCA_UAC_48K) + 0x08u * FELUCCA_UAC_AS_FIRST +
+                       0x04u * T_ML + 0x40u * T_IAD;
+        char name[64];
+        snprintf(name, sizeof name, "bcdDevice 3.%02X (a bit per layout flag)", bcd & 0xFFu);
+        check(name, le16(dev + 12) == bcd);
+    }
+    {
+        uint32_t k, ok = sd_len == 2 + 2 * strlen(FELUCCA_ID);
+        for (k = 0; ok && k < strlen(FELUCCA_ID); k++)
+            ok = sd[2 + 2 * k] == (uint8_t)FELUCCA_ID[k] && sd[3 + 2 * k] == 0;
+        check("serial string 3 = FELUCCA_ID in UTF-16LE", ok && sd[0] == sd_len && sd[1] == 3);
+    }
+
+    /* ---- the configuration, walked as a host does ---- */
+    for (off = 9; off < n; off += c[off]) {
+        const uint8_t *d = c + off;
+        if (d[0] < 2 || off + d[0] > n) {
+            check("descriptor lengths add up to wTotalLength", 0);
+            return 1;
+        }
+        if (d[1] == 0x0B) {                            /* IAD */
+            iad_first = d[2];
+            iad_n = d[3];
+            iad_cls = d[4];
+            iad_sub = d[5];
+            iad_proto = d[6];
+            niad++;
+        } else if (d[1] == 4) {                         /* interface */
+            nif++;
+            if (d[5] == 1 && d[6] == 1) {
+                ac = d[2];
+                ac_class = d[5];
+                ac_hdr = 1;
+            } else if (d[5] == 1 && d[6] == 2) {
+                as = d[2];
+                as_class = d[5];
+            } else if (d[5] == 1 && d[6] == 3) {
+                midi = d[2];
+                midi_class = d[5];
+            }
+        } else if (d[1] == 0x24 && d[2] == 1 && ac_hdr) {   /* AC header */
+            coll_n = d[7];
+            for (i = 0; i < coll_n && i < 4; i++)
+                coll[i] = d[8 + i];
+            ac_hdr = 0;
+        } else if (d[1] == 5 && d[0] == 9) {            /* endpoint */
+            if (d[2] == 0x01 && d[3] == 2)
+                midi_out++;
+            else if (d[2] == 0x81 && d[3] == 2)
+                midi_in++;
+            else if (d[2] == 0x84 && d[3] == 5)
+                audio_in++;
+        }
+    }
+    check("three interfaces numbered 0..2 (four settings: AS alt 0 / alt 1)",
+          c[4] == 3 && nif == 4 && ac == 0 && as + midi == 3);
+    if (T_ML)
+        check("interface order AC, AS, MIDI (the fix: MIDI behind the streams)", as == 1 && midi == 2);
+    else
+        check("interface order AC, MIDI, AS (1.0 .. 1.6, the macOS 13-15 bug)", midi == 1 && as == 2);
+    check("AC and the streams are one audio function",
+          ac_class == 1 && as_class == 1 && midi_class == 1);
+    check(T_ML ? "AC collection names the streaming interface only"
+               : "AC collection names the streaming and the MIDI interface",
+          T_ML ? coll_n == 1 && coll[0] == as : coll_n == 2 && coll[0] == as && coll[1] == midi);
+    check("UAC_AS_IF = the audio streaming interface", UAC_AS_IF == as);
+    check("endpoints: MIDI 0x01 / 0x81 bulk, audio 0x84", midi_out == 1 && midi_in == 1 && audio_in == 1);
+    if (T_IAD) {
+        check("one IAD, at the front, class 1 / 1 / 0", niad == 1 && iad_cls == 1 && iad_sub == 1 && iad_proto == 0);
+        check("the IAD covers AC + AS, never MIDI", iad_first == ac && iad_n == 2 &&
+              !(midi >= iad_first && midi < iad_first + iad_n));
+    } else {
+        check("no IAD", niad == 0);
+    }
+
+    printf("%s\n", fails ? "USB COMPAT TEST FAILED" : "usb compat test passed");
+    return fails ? 1 : 0;
+}
