     9, 0x24, 3, 2, 0x01, 0x01, 0, 1, 0,                    /* output terminal 2: USB streaming, from 1 */
+#define D_AC(a) D_AC_BODY(a, D_AC_HDR(a))
+#define D_AC_P(a) D_AC_BODY(a, D_AC_HDR_SMALL(a))
 #define D_AS(s)                                                                                      \
