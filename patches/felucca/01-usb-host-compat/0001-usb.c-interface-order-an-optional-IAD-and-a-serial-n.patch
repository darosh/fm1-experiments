@@ -346,7 +438,9 @@ static uint8_t usb_cdc_on = FELUCCA_CDC_DEFAULT != 0;      /* the console is pre
 #define USB_CDC_ON 0
 #define AUD_IF 0u
 #endif
-#define UAC_AS_IF (AUD_IF + 2u)
+/* the audio streaming interface's number: the plain descriptors reorder it (MIDI_LAST), the CDC layouts
