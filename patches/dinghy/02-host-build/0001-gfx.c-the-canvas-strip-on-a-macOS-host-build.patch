From 4902b87f7a662373748bcd2d29b20964725bbee0 Mon Sep 17 00:00:00 2001
From: Jan Forst <ensonador@gmail.com>
Date: Sat, 24 Oct 2026 19:48:11 +0200
Subject: [PATCH] gfx.c: the canvas strip on a macOS host build

tests/run_host.sh compiles gfx.c with cc, and Mach-O has no bare ".pool" section (clang:
"mach-o section specifier requires a segment and section separated by a comma"). An ordinary static
on __APPLE__; the firmware build (ELF, pi32v2) keeps the pool. CS-1, which shares this platform,
already does this through tests/fake_fm1.h's FM1_POOL.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 firmware/src/gfx.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/firmware/src/gfx.c b/firmware/src/gfx.c
index 05bbfd6..becc050 100644
--- a/firmware/src/gfx.c
+++ b/firmware/src/gfx.c
@@ -17,7 +17,12 @@ typedef struct {               /* proportional, see tools/gen_font.py */
 #ifndef CV_MAX
 #define CV_MAX (240u * 124u)      /* the graph strip is 240 x 124 */
 #endif
+#ifdef __APPLE__
+/* the host build (tests/run_host.sh) is Mach-O, which has no bare ".pool" section: an ordinary static */
+static uint16_t cv_px[CV_MAX];
+#else
 static uint16_t cv_px[CV_MAX] __attribute__((section(".pool")));
+#endif
 static uint32_t cv_w, cv_h;
 static int32_t cv_oy;            /* y offset for graph drawing */
 
-- 
