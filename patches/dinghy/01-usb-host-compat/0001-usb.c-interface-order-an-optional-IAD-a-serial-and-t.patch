 #define USB_NIF (2 + FELUCCA_UAC + 2 * FELUCCA_CDC)
+/* the MIDI streaming function at interface m, and (FELUCCA_UAC) the audio streaming function at s */
+#define D_MIDI(m)                                                                                    \
