+#ifndef FELUCCA_USB_SNUM
+#define FELUCCA_USB_SNUM 0
+#endif
 enum { S_FADDR = 0, S_POWER = 1, S_INTRTX1 = 2, S_INTRTX2 = 3, S_INTRRX1 = 4, S_INTRRX2 = 5, S_INTRUSB = 6,
        S_INTRTX1E = 7, S_INTRTX2E = 8, S_INTRRX1E = 9, S_INTRRX2E = 10, S_INTRUSBE = 11, S_FRAME1 = 12,
        S_FRAME2 = 13, S_INDEX = 14,
@@ -171,16 +227,55 @@ static void midi_out_event(uint32_t pkt)            /* from the audio ISR */
 }
 
 /* ------------------------------------------------------- descriptors --- */
-/* interfaces: 0 audio control, 1 MIDI streaming, 2 audio streaming (FELUCCA_UAC), then CDC's two.
- * bcdDevice: 3.00 MIDI, +0.01 CDC, +0.10 the audio input, +0.20 more with 48 kHz (2.5) (hosts cache descriptors
- * per version) */
+/* interfaces: 0 audio control, then the MIDI and (FELUCCA_UAC) audio streaming interfaces, then CDC's
+ * two. FELUCCA_UAC_MIDI_LAST puts the streaming interface before MIDI (AC, AS, MIDI) and takes MIDI out
+ * of the AC header's collection: the fm-1-experiments bisection of #67 (macOS 13-15); the order is what
+ * makes the audio input enumerate. FELUCCA_UAC_AC_COLLECT drops MIDI from the collection on its own.
+ * bcdDevice: 3.00 MIDI, +0.01 CDC, +0.10 the audio input, +0.20 more with 48 kHz (2.5), and a bit per
+ * host-compat flag (hosts cache descriptors per version) */
+#define UAC_BCD_HC (0x02 * FELUCCA_UAC_AC_COLLECT + 0x04 * FELUCCA_UAC_MIDI_LAST + 0x40 * FELUCCA_UAC_IAD)
 #define CDC_IF (2 + FELUCCA_UAC)
-#define UAC_AS_IF 2u
-#define CFG_LEN (101 + 74 * FELUCCA_CDC + 74 * FELUCCA_UAC + 3 * FELUCCA_UAC_48K)
