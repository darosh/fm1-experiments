+#error "FELUCCA_UAC_IAD: the plain build's IAD; the CDC layouts have their own"
+#endif
+#if FELUCCA_UAC_IAD && !FELUCCA_UAC
+#error "FELUCCA_UAC_IAD: no audio function to associate (needs FELUCCA_UAC)"
+#endif
+#if FELUCCA_UAC_IAD && !FELUCCA_UAC_MIDI_LAST
+#error "FELUCCA_UAC_IAD: the audio IAD needs the audio interfaces contiguous (FELUCCA_UAC_MIDI_LAST)"
+#endif
