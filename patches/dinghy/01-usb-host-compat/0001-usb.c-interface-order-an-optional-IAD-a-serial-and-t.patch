+#if FELUCCA_UAC
+#if FELUCCA_UAC_48K
+#define FMT_LEN 14                          /* type I: 2 ch, 16 bit, 44100 / 48000 */
+#define FMT_NRATES 2
+#define FMT_RATES 0x44, 0xAC, 0x00, 0x80, 0xBB, 0x00
