+#define D_AS(s)                                                                                      \
+    9, 4, (s), 0, 0, 1, 2, 0, 0,                        /* audio streaming, alt 0: no bandwidth */    \
+    9, 4, (s), 1, 1, 1, 2, 0, 0,                        /* alt 1: the stream */                      \
+    7, 0x24, 1, 2, 1, 0x01, 0x00,                       /* AS general: terminal 2, delay 1, PCM */    \
