+                             collection alone (FELUCCA_UAC_AC_COLLECT in the environment) is not enough
+  usb_iad = true             an IAD and the misc/IAD device class for the audio function
+                             (FELUCCA_UAC_IAD): the audio interfaces form one function. Descriptor
+                             hygiene, not a host fix; wants usb_midi_last to keep AC + AS contiguous
+  usb_serial = "..."         the device's serial number string (FELUCCA_USB_SERIAL; default: the identity)
   mirror = true              the screen and panel mirrored over USB (FM1B_MIRROR: device/mirror.c; web/mirror/,
                              tools/fm1_mirror.py), the panel played from the host; FM1B_MIRROR=1 in the environment
                              builds it in whatever fm1.toml says (an app's demo build), FM1B_POOL_SPARE=N the
@@ -574,12 +581,20 @@ def build_app():
             flags.append(f"-D{flag}={int(bool(CONF[key]))}")
     if CONF.get("usb_audio_first"):
         flags.append("-DFELUCCA_UAC_AS_FIRST=1")
+    for key, flag in (("usb_midi_last", "FELUCCA_UAC_MIDI_LAST"), ("usb_iad", "FELUCCA_UAC_IAD")):
+        if key in CONF and flag not in os.environ:
+            flags.append(f"-D{flag}={int(bool(CONF[key]))}")
     for flag in ("FM1B_CDC", "FM1B_UAC", "FM1B_UAC_OUT", "FM1B_TRS"):
         v = os.environ.get(flag)    # unset: fm1.toml's, the app's (app.h) or the platform's default (device/unity.c)
         if v in ("0", "1"):
             flags.append(f"-D{flag}={v}")
+    for flag in ("FELUCCA_UAC_AC_COLLECT", "FELUCCA_UAC_MIDI_LAST"):
+        v = os.environ.get(flag)    # fm1.toml's usb_ac_collect / usb_midi_last; an env 0/1 bisects a build
+        if v in ("0", "1"):
+            flags.append(f"-D{flag}={v}")
     flags.append(f'-DFELUCCA_ID="{PRODUCT}"')
-    for key, macro in (("usb_manufacturer", "FELUCCA_USB_MANUFACTURER"), ("usb_product", "FELUCCA_USB_PRODUCT")):
+    for key, macro in (("usb_manufacturer", "FELUCCA_USB_MANUFACTURER"), ("usb_product", "FELUCCA_USB_PRODUCT"),
+                       ("usb_serial", "FELUCCA_USB_SERIAL")):
         if CONF.get(key):
             flags.append(f'-D{macro}="{CONF[key]}"')
     if VERSION:
