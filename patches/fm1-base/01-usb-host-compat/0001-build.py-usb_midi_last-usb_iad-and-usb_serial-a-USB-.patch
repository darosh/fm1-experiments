 run trs sh -c "$CC -O2 -w -Ibsp/chip -Ibsp/boards/fm1 -Idevice -o $OUT/trs_test tests/trs_test.c && $OUT/trs_test"
 run storage sh -c "$CC -O2 -w -o $OUT/storage_test tests/storage_test.c && $OUT/storage_test"
+# the USB descriptors (felucca-bsp chip/usb.c) under each layout: the plain audio build, the two macOS
+# layout flags each alone and together, the audio output, and the build without audio
+usb_desc() {   # NAME FLAGS
+    run "usb-desc-$1" sh -c "$CC -O2 -w -Ibsp/chip -Ibsp/boards/fm1 $2 -o '$OUT/usb_desc_test' \
+        tests/usb_desc_test.c && '$OUT/usb_desc_test'"
+}
+usb_desc audio "-DFELUCCA_UAC=1"
+usb_desc audio-collect "-DFELUCCA_UAC=1 -DFELUCCA_UAC_AC_COLLECT=1"
+usb_desc audio-midi-last "-DFELUCCA_UAC=1 -DFELUCCA_UAC_MIDI_LAST=1"
+usb_desc audio-both "-DFELUCCA_UAC=1 -DFELUCCA_UAC_AC_COLLECT=1 -DFELUCCA_UAC_MIDI_LAST=1"
+usb_desc audio-out "-DFELUCCA_UAC=1 -DFELUCCA_UAC_OUT=1"
+usb_desc audio-out-both "-DFELUCCA_UAC=1 -DFELUCCA_UAC_OUT=1 -DFELUCCA_UAC_MIDI_LAST=1"
+usb_desc midi-only "-DFELUCCA_UAC=0"
+usb_desc iad "-DFELUCCA_UAC=1 -DFELUCCA_UAC_MIDI_LAST=1 -DFELUCCA_UAC_IAD=1"
+usb_desc serial '-DFELUCCA_UAC=1 -DFELUCCA_USB_SERIAL=\"FM-1_1000\"'
 run fastmath sh -c "$CC -O2 -w -o $OUT/fastmath_test tests/fastmath_test.c -lm && $OUT/fastmath_test"
 run installer "$PY" tests/install_test.py
