From 0d28b2890bc8bb1bc69fb91037b0888d352518cb Mon Sep 17 00:00:00 2001
From: Jan Forst <ensonador@gmail.com>
Date: Fri, 23 Oct 2026 18:04:56 +0200
Subject: [PATCH 1/5] USB: MIDI behind the streams, an audio IAD, and the USB
 names

Enables fm1-base's usb_midi_last and usb_iad:

- usb_midi_last (FELUCCA_UAC_MIDI_LAST) moves the MIDI function behind the streaming interfaces
  (AC, AS, [ASO], MIDI). Bisected on macOS 15.8.1: this ordering is what makes the audio input
  enumerate; keeping MIDI out of the AC collection alone is not enough. Felucca#67, kmplngj#532.
- usb_iad (FELUCCA_UAC_IAD) gives the audio function an IAD covering AC + AS only, with the
  misc/IAD device class. Descriptor hygiene rather than a host fix (the plain build enumerates on
  every host we tried); it needs usb_midi_last so AC + AS stay contiguous, with MIDI outside.

Verified working on macOS 15.8.1, Windows 11, Linux, Android and iPadOS: audio capture enumerates
and MIDI binds on each. The device is named FM-1 / FM-1 LOOM-8 (Manufacturer / Model, the product
being the CoreAudio and CoreMIDI name), and a serial number strings it apart from other firmwares
sharing VID/PID 1209:0001 (AMB-1's name no longer sticks).

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 app/fm1.toml | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/app/fm1.toml b/app/fm1.toml
index 205c298..ee0f244 100644
--- a/app/fm1.toml
+++ b/app/fm1.toml
@@ -1,9 +1,9 @@
 # LOOM-8's build settings (fm1-base's tools/build.py: ./build.sh)
 name = "loom"                  # the build's files: loom.fwsc, loom-X.Y.fwsc, loom_host (APP_NAME, LOOM-8, is in app.h)
 id_prefix = "FM-1_10"          # package identity: dev FM-1_1000, releases FM-1_10XXYYZZ (every single digit was taken)
-usb_manufacturer = "LOOM-8"
-usb_product = "LOOM-8 FM-1"
-ble = true                     # Bluetooth MIDI with a computer
+usb_manufacturer = "FM-1"      # Manufacturer in Audio MIDI Setup
+usb_product = "FM-1 LOOM-8"    # Model, and the CoreAudio / CoreMIDI device name
+ble = true                     # Bluetooth MIDI with a computer (the own stack)
 ble_stack = "own"              # Optimist's own stack (fm1-base bt/), no JieLi library
 ble_pairing = true
 ble_central = true
@@ -12,6 +12,10 @@ usb_audio_in = true            # the master output recordable over USB (Setup's
 usb_audio_first = true         # the audio streaming interface listed first (macOS shows the audio device: felucca-bsp #10)
 usb_audio_out = false
 usb_host = true                # the USB port as a MIDI host (Setup's USB PORT): a controller or a synth, through a powered hub
+usb_midi_last = true           # MIDI after the streaming interfaces (macOS audio, Felucca#67): bisected,
+                               # this is the one that matters; it also keeps MIDI out of the AC collection
+usb_iad = true                 # the audio function's IAD (FELUCCA_UAC_IAD): descriptor hygiene,
+                               # not a host fix; checked on macOS 15, Windows 11, Linux, Android, iPadOS
 backup = true                  # projects and presets over USB (base/tools/fm1_backup.py); the page adds the samples (app/web/backup/extras.js)
 backup_ext = "loom8"           # the backup page's files: NAME.loom8
 backup_holds = "the three projects, the user presets and the samples"
