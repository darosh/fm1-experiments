+void domino_step(const tpat_t *a, int ia, int ak, const tpat_t *b, int bi, int bk, step_t *out)
+{
+    int lb = pat_n(b);
+    *out = a->st[ia];                /* the trigger: its rhythm, velocity, length, tricks, condition */
+    if (step_empty(out))             /* no trigger here */
+        return;
+    for (int j = 0; j < SN; j++)
+        out->note[j] = 0;            /* the trigger's own notes are placeholders */
+    if (!step_empty(&b->st[bi % lb]))
+        notes_cross(&b->st[bi % lb], bk, ak, out);   /* a rest in b leaves the hit silent */
+}
 void weave_step(const tpat_t *a, int ak, const tpat_t *b, int bk, int rule, uint32_t pos, step_t *out)
 {
     int la = pat_n(a), lb = pat_n(b), ia = (int)(pos % (uint32_t)la), ib = (int)(pos % (uint32_t)lb);
@@ -299,6 +310,9 @@ void weave_step(const tpat_t *a, int ak, const tpat_t *b, int bk, int rule, uint
         if (!step_empty(out) && (n = onset_at(b, (int)(pos / (uint32_t)la) * onsets(a, la) + onsets(a, ia))))
             notes_cross(n, bk, ak, out);
         break;
+    case WV_DOMINO:                   /* A's hits fire B's notes, B one step per hit (its own length) */
+        domino_step(a, ia, ak, b, (int)(pos / (uint32_t)la) * onsets(a, la) + onsets(a, ia), bk, out);
+        break;
     default:                          /* WV_NOTES: B's step (its rhythm) with A's next notes */
         *out = b->st[ib];
         if (step_empty(out))
@@ -312,7 +326,7 @@ void weave_step(const tpat_t *a, int ak, const tpat_t *b, int bk, int rule, uint
 
 void pattern_woven(tpat_t *out, const tpat_t *a, int ak, const tpat_t *b, int bk, int rule)
 {
-    int la = pat_n(a), lb = pat_n(b), len = la > lb ? la : lb;
+    int la = pat_n(a), lb = pat_n(b), len = rule == WV_DOMINO ? la : la > lb ? la : lb;
     if (rule == WV_BARS && len < 32)             /* (the bars in turn need two of them) */
         len = len * 2 > NSTEP ? NSTEP : len * 2;
     *out = *a;
