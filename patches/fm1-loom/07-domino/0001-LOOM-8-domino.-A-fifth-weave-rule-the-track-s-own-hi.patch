diff --git a/docs/MANUAL.md b/docs/MANUAL.md
index 6b6578d..ac83a72 100644
--- a/docs/MANUAL.md
+++ b/docs/MANUAL.md
@@ -426,6 +426,14 @@ which WEAVE track key brings it in. The rules:
 | steps | its own steps and the other's in turn |
 | rhythm | its own rhythm, playing the other pattern's pitches in order, round and round |
 | pitch | the other pattern's rhythm, playing this track's pitches |
+| domino | its own hits fire the other pattern's notes, one note for each hit |
+
+**Domino** splits the weave into a trigger layer and a note layer. The track's own steps are the triggers: their
+rhythm, velocity, length and tricks count, but not their notes. Each trigger that fires takes the next step of
+the other pattern's notes (crossing kits and melodies as the other rules do), then the note layer moves on one
+step. It loops at its own length, so the two drift: a three-step note pattern turns round under a one-bar trigger.
+A rest in the note pattern is a silent trigger. A muted track still moves the note layer on, and hold and pulse
+repeat the note that fired. **KEEP AS PATTERN** writes one trigger cycle at the trigger pattern's length.
 
 Each pattern loops at its own length, and the turns count from the start, so a one-bar pattern woven by bars
 plays its own bar, then the other's. A track can weave with any track. A drum track's sounds become notes on a
diff --git a/tests/host/seq_test.c b/tests/host/seq_test.c
index f5c588f..74c548b 100644
--- a/tests/host/seq_test.c
+++ b/tests/host/seq_test.c
@@ -2170,6 +2170,75 @@ static void t_weave_live(void)        /* the sequencer weaves live: T1's P1 with
     printf("ok %s\n", cur);
 }
 
+static void domino_setup(void)        /* T1's hits are the triggers, T2 P1 (3 steps) the note layer */
+{
+    P.pat[0][0].len = 4;
+    note(0, 0, 60, 100);                          /* (the triggers' own notes are placeholders) */
+    note(0, 2, 60, 100);
+    P.pat[1][0].len = 3;
+    note(1, 0, 72, 100);                          /* 72, a rest, 76 */
+    note(1, 2, 76, 100);
+    S.mute = 1u << 1;                             /* (T2 itself silent) */
+    S.wv_from[0] = 2;
+    S.wv_pat[0] = 0;
+    S.wv_rule[0] = WV_DOMINO;
+    S.wv_live = 1u;
+}
+
+static void t_domino(void)            /* domino live: each trigger fires the next note layer's step */
+{
+    cur = "domino";
+    reset();
+    domino_setup();
+    start();
+    run(16 * L16);                                /* eight triggers: 72, -, 76, 72, -, 76 ... */
+    CHECK(count(E_ON, 0) == 5);
+    {
+        static const int want[5] = {72, 76, 72, 76, 72};
+        for (int i = 0; i < 5; i++)
+            CHECK(on_n(i)->a == want[i]);
+        CHECK(near(on_n(1)->t, 4 * L16, 4));      /* the trigger at step 3 was a rest: nothing at 2 * L16 */
+        CHECK(near(on_n(2)->t, 6 * L16, 4));
+    }
+    stop();
+    /* pulse: the trigger's note repeats over the covered step; the note layer moves on only at the next trigger */
+    reset();
+    domino_setup();
+    P.pat[1][0].len = 3;
+    note(1, 1, 74, 100);                          /* 72, 74, 76 */
+    st(0, 0)->comp = SC_PULSE;
+    st(0, 0)->cval = 0;                           /* one repeat */
+    start();
+    run(3 * L16 + 10);
+    CHECK(count(E_ON, 0) == 3);
+    CHECK(on_n(0)->a == 72 && on_n(1)->a == 72 && near(on_n(1)->t, L16, 2));
+    CHECK(on_n(2)->a == 74);                      /* the next trigger, not the covered note */
+    stop();
+    /* multiply: the same note twice, the note layer moving on once */
+    reset();
+    domino_setup();
+    P.pat[1][0].len = 3;
+    note(1, 1, 74, 100);
+    st(0, 0)->comp = SC_MULTIPLY;
+    st(0, 0)->cval = 1;                           /* two hits */
+    start();
+    run(3 * L16 + 10);
+    CHECK(count(E_ON, 0) == 3);
+    CHECK(on_n(0)->a == 72 && on_n(1)->a == 72 && on_n(2)->a == 74);
+    stop();
+    /* a muted track still moves the note layer on, so unmuting does not shift the phrase */
+    reset();
+    domino_setup();
+    S.mute = (1u << 0) | (1u << 1);
+    start();
+    run(2 * L16 + 10);                            /* two triggers consumed while silent */
+    S.mute = 1u << 1;                             /* T1 back, T2 still silent */
