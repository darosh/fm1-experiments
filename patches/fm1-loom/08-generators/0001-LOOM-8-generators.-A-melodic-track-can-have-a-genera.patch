+        g[0] = GEN_OFF;
+    return g[0];
+}
+
+int lane_gen_set(lane_t *L, int trk, int pat, const uint8_t g[4])
+{
+    int k = lane_find(L, trk, pat, LANE_GEN), i;
+    if (g[0] == GEN_OFF) {            /* off: no lane at all */
+        if (k >= 0)
+            lane_clear(L, k);
+        return 0;
+    }
+    if (k < 0 && (k = lane_alloc(L, trk, pat, LANE_GEN)) < 0)
+        return -1;
+    for (i = 0; i < 4; i++)
+        L[k].val[i] = g[i];
+    return 0;
+}
