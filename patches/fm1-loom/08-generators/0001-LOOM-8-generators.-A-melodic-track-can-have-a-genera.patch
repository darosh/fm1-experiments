+int step_root(const tpat_t *p, uint8_t n[SN])
+{
+    int i, k;
+    for (i = 0; i < NSTEP; i++)
+        if (!step_empty(&p->st[i]) && p->st[i].note[0]) {
+            for (k = 0; k < SN; k++)
+                n[k] = p->st[i].note[k];
+            return i;
+        }
+    n[0] = 60;
+    for (k = 1; k < SN; k++)
+        n[k] = 0;
+    return -1;
+}
