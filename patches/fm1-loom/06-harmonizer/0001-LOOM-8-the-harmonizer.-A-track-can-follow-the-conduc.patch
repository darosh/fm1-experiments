+    start();
+    run(L16 + 40);
+    CHECK(on_n(0)->a == 60);
+    seq_key(&S, 2, 60, 0, 0);
+    seq_key(&S, 2, 64, 0, 0);
+    seq_key(&S, 2, 67, 0, 0);
+    stop();
+    /* no chord at all: mode 3 falls back to diatonic (a degree of 0 leaves the note) */
+    reset();
+    par[0][TP_BRAIN] = BM_HARMONY;
+    start();
