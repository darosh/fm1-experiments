+    int pat = s->ppat[t] < NPATT ? s->ppat[t] : 0;
+    if (tr->st_pool_lane != 0xFF && tr->st_pool_epoch == lane_epoch) {
+        const lane_t *l = &s->P->lane[tr->st_pool_lane];
+        if (l->used && l->param == LANE_POOL && l->trk == t && l->pat == pat)
