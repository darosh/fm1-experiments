+static uint32_t st_hash(uint32_t x)              /* a 32-bit avalanche (splitmix's) */
+{
+    x ^= x >> 16;
+    x *= 0x7feb352du;
+    x ^= x >> 15;
+    x *= 0x846ca68bu;
+    x ^= x >> 16;
+    return x;
