+    mask &= 0x0FFFu;
+    if (!mask) {                      /* an empty pool: no lane at all */
+        if (k >= 0)
+            lane_clear(L, k);
+        return 0;
+    }
+    if (k < 0 && (k = lane_alloc(L, trk, pat, LANE_POOL)) < 0)
+        return -1;
+    L[k].val[0] = (uint8_t)mask;
+    L[k].val[1] = (uint8_t)(mask >> 8);
+    return 0;
